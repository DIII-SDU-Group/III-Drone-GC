<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>iii_drone_gc</name>
  <version>2.2.0</version>
  <description>
    The iii_drone_gc package. This package contains the ground control functionality of the III-Drone system.
  </description>
  <maintainer email="ffn@sdu.dk">ffn</maintainer>
  <license>Proprietary</license>

  <exec_depend>iii_drone_contracts</exec_depend>
  <exec_depend>python3-fastapi</exec_depend>
  <exec_depend>python3-httpx</exec_depend>
  <exec_depend>python3-pydantic</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>
  <exec_depend>python3-websockets</exec_depend>
  <exec_depend>python3-zeroconf</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>
