# OptiTrack lab ground computer (opti_track profile).
# Copy to ~/.config/iii-ground-control.env on the operator computer. The GUI
# reaches the aircraft's runtime API over the lab Wi-Fi; QGroundControl uses
# the telemetry radio. Pin all three values; a mismatch blocks selection.
# The runtime and system IDs are the aircraft's provisioned identity
# (III_RUNTIME_API_ID and III_RUNTIME_API_SYSTEM_ID in /etc/iii/runtime.env,
# written by `iii host provision --profile opti_track`).
III_GC_EXPECTED_RUNTIME_ID=iii-runtime
III_GC_EXPECTED_SYSTEM_ID=iii-drone
III_GC_EXPECTED_PROFILE=opti_track

III_GC_PROXY_HOST=127.0.0.1
III_GC_PROXY_PORT=8780
III_GC_FRONTEND_PORT=5173
III_GC_PROXY_PUBLIC_URL=http://127.0.0.1:8780
III_GC_PROXY_CORS_ORIGINS=http://127.0.0.1:5173

III_GC_COMPOSE_PROJECT=iii-ground-control
# III_GC_LOG_DIR=/var/log/iii-ground-control
